.claude/
.env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/
.idea/

# 大体积数据与模型（保留本地/网盘，不进 Git）
*.pkl
*.h5
*.pt
*.pth
*.rds
*.RData
*.RDataTmp*
*.chk
*.log

# 文献 PDF 一律不入库（含子目录）
*.pdf
**/*.pdf
HTEBO/02_文献/papers/**/*.pdf

# Office 锁临时文件
~$*.xlsx
~$*.pptx
~$*.docx

# Gaussian 计算中间产物（可再生，不进 Git）
*.gjf
*.gif
*.out

# 百度网盘同步冲突副本
*冲突文件*

# TransferBO：默认忽略；放行代码、配置、数据表与文稿（不含 PDF）
# （不入库：results / exports / third_party / PDF）
TransferBO/**
!TransferBO/.gitignore
!TransferBO/README.md
!TransferBO/pyproject.toml
!TransferBO/requirements.txt
!TransferBO/requirements-botorch.txt
!TransferBO/scripts/
!TransferBO/scripts/**
!TransferBO/src/
!TransferBO/src/**
!TransferBO/configs/
!TransferBO/configs/**
!TransferBO/tests/
!TransferBO/tests/**
!TransferBO/docs/
!TransferBO/docs/**
!TransferBO/data/
!TransferBO/data/README.md
!TransferBO/data/descriptors/
!TransferBO/data/descriptors/**
!TransferBO/data/processed/
!TransferBO/data/processed/**
!TransferBO/data/raw/
!TransferBO/data/raw/**
# 原始超大外部表仍本地保留
TransferBO/data/raw/external/BH_HTE_Curated_Dataset_v20260219.csv
# PDF 即使落在放行目录也不入库
TransferBO/**/*.pdf
