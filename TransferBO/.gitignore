exports/**
docs/**
notebooks/**
notes/**
*.pptx
*.docx
*.png
*.jpg
*.jpeg
*.svg
*.tgz
*.tar.gz
*.zip

# 数据：描述符 + 清洗表 + 常规 raw 可入库；超大原始表由根 .gitignore 排除
data/raw/**
!data/raw/.gitkeep
!data/raw/**/
!data/raw/**/*.csv
!data/raw/**/*.md
# 超大外部原始表本地保留
data/raw/external/BH_HTE_Curated_Dataset_v20260219.csv
!data/processed/
!data/processed/**
!data/descriptors/
!data/descriptors/**
!data/README.md

