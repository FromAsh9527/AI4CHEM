*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# IDE / notebooks
.idea/
.vscode/
.ipynb_checkpoints/
.pytest_cache/

# 第三方依赖（本地保留）
third_party/

# 运行产物与汇报材料（不入库）
results/**
